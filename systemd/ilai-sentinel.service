[Unit]
Description=Ippocra ILAI Sentinel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/sentinel --config %h/.config/ilai-sentinel/sentinel.toml daemon
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
